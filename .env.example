# Local / manual setup only.
#
# On the Raspberry Pi this file is GENERATED by the deploy workflow from
# repository secrets and variables -- do not hand-edit it there, your changes
# will be overwritten on the next deploy. Change the secret or variable in
# GitHub instead and re-run the workflow. See README.md.
#
# Use this template when bringing the stack up by hand (a fresh Pi, or local
# testing). Copy to .env; .env is gitignored.

DB_HOST=influxdb.mbaruk.com
DB_PORT=8086
DB_USERNAME=changeme
# Careful: Compose interpolates .env values, so any literal $ must be doubled.
# A password of   pa$word   must be written here as   pa$$word   -- otherwise
# Compose treats $word as an undefined variable and silently drops it, and the
# container gets "pa". The deploy workflow does this escaping for you; only
# hand-written .env files need it.
# Verified: unescaped p@ss$word-${DB_NAME}-x reaches the container as
# p@ss-composetest-x.
DB_PASSWORD=changeme
DB_NAME=ups

# Seconds between samples. The old cron-driven version was fixed at 60.
SAMPLE_INTERVAL=30

# INFO, or DEBUG for more detail.
LOG_LEVEL=INFO

# Path to the RS485 adapter. Prefer the /dev/serial/by-id symlink over a bare
# /dev/ttyUSBn: the adapter is powered from the inverter, so an inverter outage
# de-enumerates it and the kernel may hand it back on a different node. That
# happened on 2026-08-24 (ttyUSB0 -> ttyUSB1) and stopped collection overnight.
# List them with: ls -l /dev/serial/by-id/
# by-path, not by-id: it identifies the USB socket rather than the chipset.
# CH340 adapters carry no serial number, so a second one -- e.g. a cable added
# to read the battery BMS directly -- produces an identical by-id name and the
# two become indistinguishable.
USB_DEVICE=/dev/serial/by-path/platform-20980000.usb-usb-0:1.2:1.0-port0

# Modbus link parameters. Only change these if probe.py --scan finds the
# inverter answering somewhere else after a hardware or firmware change.
#MODBUS_SLAVE_ID=4
#MODBUS_BAUD_RATE=19200

# Battery BMS, read directly over RS485. The inverter has no SOC register at
# all, so this is the only source of state of charge, per-cell voltages, cycle
# count and remaining capacity. Empty disables it.
# Pinout (LP1600 manual): RJ45 pin 1 = B, pin 2 = A, pin 3 = GND.
#BATTERY_DEVICE=/dev/serial/by-path/platform-20980000.usb-usb-0:1.4:1.0-port0
#BMS_SLAVE_ID=1
#BMS_BAUD_RATE=9600
