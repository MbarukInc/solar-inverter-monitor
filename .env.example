# Local / manual setup only.
#
# On the Raspberry Pi this file is GENERATED by the deploy workflow from
# repository secrets and variables -- do not hand-edit it there, your changes
# will be overwritten on the next deploy. Change the secret or variable in
# GitHub instead and re-run the workflow. See README.md.
#
# Use this template when bringing the stack up by hand (a fresh Pi, or local
# testing). Copy to .env; .env is gitignored.

DB_HOST=influxdb.mbaruk.com
DB_PORT=8086
DB_USERNAME=changeme
# Careful: Compose interpolates .env values, so any literal $ must be doubled.
# A password of   pa$word   must be written here as   pa$$word   -- otherwise
# Compose treats $word as an undefined variable and silently drops it, and the
# container gets "pa". The deploy workflow does this escaping for you; only
# hand-written .env files need it.
# Verified: unescaped p@ss$word-${DB_NAME}-x reaches the container as
# p@ss-composetest-x.
DB_PASSWORD=changeme
DB_NAME=ups

# Seconds between samples. The old cron-driven version was fixed at 60.
SAMPLE_INTERVAL=30

# INFO, or DEBUG for more detail.
LOG_LEVEL=INFO

# Override if the inverter enumerates somewhere other than /dev/ttyUSB0.
#USB_DEVICE=/dev/ttyUSB0

# Modbus link parameters. Only change these if probe.py --scan finds the
# inverter answering somewhere else after a hardware or firmware change.
#MODBUS_SLAVE_ID=4
#MODBUS_BAUD_RATE=19200
